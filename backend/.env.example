# Para rodar o backend FORA do Docker (npm run dev), copie para .env
PORT=4000

# Conexão com o PostgreSQL (uma URL só). Em nuvem (Render), use a Internal Database URL.
DATABASE_URL=postgres://stoprotas:stoprotas@127.0.0.1:5432/stoprotas
# Só ligue se o provedor exigir SSL (ex.: alguns bancos gerenciados):
# DB_SSL=true

JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES=7d
